# Secret key from Novu Dashboard → API Keys. Never ship this to the Android app.
NOVU_SECRET_KEY=

# Public application identifier from the same API Keys page. The app uses it
# only to open an Inbox session. It is not a secret.
NOVU_APPLICATION_IDENTIFIER=

# Identifier of the FCM integration in Novu (Integration Store → FCM → Identifier).
# Required when more than one push integration is active.
NOVU_FCM_INTEGRATION_IDENTIFIER=

# Workflow that contains an Inbox step and a Push step.
NOVU_WORKFLOW_ID=

# Novu subscriber this example uses for Inbox, push tokens, and the test trigger.
# The Android app does not ask for this.
SUBSCRIBER_ID=demo-user

# Novu US Cloud API URL. For EU region use: https://eu.api.novu.co
NOVU_API_URL=https://api.novu.co
NOVU_INBOX_API_URL=https://api.novu.co/v1
NOVU_SOCKET_URL=wss://socket.novu.co
